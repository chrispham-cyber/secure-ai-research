{
  "realm": "sair",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "senior_analyst", "description": "SAIR senior analyst: wider retrieval scope + live fetch-on-miss." },
      { "name": "research_analyst", "description": "SAIR research analyst: routine (ROUTINE-tier) retrieval only." }
    ]
  },
  "defaultRole": {
    "name": "default-roles-sair",
    "description": "Default roles for the sair realm — intentionally empty so a user's token carries ONLY their explicitly assigned realm role (keeps the single-String `role` claim deterministic).",
    "composite": true,
    "composites": { "realm": [], "client": {} }
  },
  "clients": [
    {
      "clientId": "sair-api",
      "name": "Secure AI Research API",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "realm-role-to-role-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "sair-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sair-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "senior-test",
      "enabled": true,
      "emailVerified": true,
      "email": "senior-test@sair.local",
      "firstName": "Senior",
      "lastName": "Analyst",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "pw", "temporary": false }],
      "realmRoles": ["senior_analyst"]
    },
    {
      "username": "analyst-test",
      "enabled": true,
      "emailVerified": true,
      "email": "analyst-test@sair.local",
      "firstName": "Research",
      "lastName": "Analyst",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "pw", "temporary": false }],
      "realmRoles": ["research_analyst"]
    }
  ]
}
