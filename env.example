# Secure AI Research Platform — environment template.
# Copy to .env and adjust:  cp env.example .env
#
# PUBLIC / synthetic data only. Put NO real secrets in this file or in .env.
# The values below are safe local-dev defaults, not credentials for any real system.

# --- Application settings (read by src/secure_ai_research/config.py, prefix SAIR_) ---
SAIR_DB_URL=postgresql://sair:sair@localhost:5432/sair
SAIR_MINIO_ENDPOINT=localhost:9000
SAIR_MINIO_ACCESS_KEY=minioadmin
SAIR_MINIO_SECRET_KEY=minioadmin
SAIR_OLLAMA_HOST=http://localhost:11434
SAIR_EMBEDDING_MODEL=nomic-embed-text
SAIR_MODEL_REGISTRY_PATH=infrastructure/model-runtime/model-registry.json
SAIR_AUDIT_LOG_PATH=audit/research-records.jsonl
SAIR_DATA_CLASSIFICATION=PUBLIC

# --- docker-compose interpolation (local service credentials for dev only) ---
SAIR_DB_USER=sair
SAIR_DB_PASSWORD=sair
SAIR_DB_NAME=sair
SAIR_KEYCLOAK_ADMIN=admin
SAIR_KEYCLOAK_ADMIN_PASSWORD=admin

# --- Optional: build provenance surfaced at GET /version ---
# SAIR_GIT_SHA=
